# Copy to .env only if missing; retain existing credentials. Do not commit real credentials.
# Must equal the target gptbot account's BOT_TOKEN.
BOT_TOKEN=
API_ID=
API_HASH=
# Same as gptbot PARSEHUB_WORKER_SECRET, at least 32 characters.
WORKER_SERVICE_KEY=
WORKER_CACHE_MAX_BYTES=10737418240
# Optional Compose variable: export it or pass --env-file .env.
PARSEHUB_WORKER_HTTP_PORT=8080

# Original ParseHub paths (DATABASE_URL is relative to /app inside the image).
DATA_PATH=data
DOWNLOAD_DIR=downloads
DATABASE_URL=sqlite+aiosqlite:///data/db/database.db
